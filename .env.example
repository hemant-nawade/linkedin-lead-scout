# Public URL of the app (no trailing slash). Must be https in production.
BASE_URL=http://localhost:8000
# Long random string. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# SQLite locally; Postgres in production, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/leadscout.db

# Sign In with LinkedIn (OpenID Connect) — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional; defaults to BASE_URL/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=

# Auto-discover public LinkedIn posts (Google search API). Free key: https://serper.dev (2,500 searches)
SERPER_API_KEY=
# or SerpAPI instead: https://serpapi.com
SERPAPI_API_KEY=

# Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Vendor webhook secret (header X-Webhook-Secret). Empty = webhook disabled.
WEBHOOK_SECRET=

# Optional: create admin on first start (otherwise the first person to sign up becomes admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
